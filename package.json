{
  "name": "sn-typescript-util",
  "version": "1.6.1",
  "description": "A TypeScript utility for ServiceNow developers using VS Code",
  "bin": {
    "snts": "bin/snts.js"
  },
  "keywords": [
    "ServiceNow",
    "Service Portal",
    "TypeScript"
  ],
  "author": "Steven Gregory",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevengregory/sn-typescript-util.git"
  },
  "files": [
    "bin",
    "scripts",
    "src"
  ],
  "scripts": {
    "format": "prettier --write ./bin/*.js ./src/*.ts ./scripts/*.ts",
    "lint": "bun eslint .",
    "prepublishOnly": "bun run typecheck",
    "release": "bun ./scripts/release.ts",
    "release:status": "bun ./scripts/release.ts --status",
    "typecheck": "tsc --noEmit && tsc -p scripts",
    "watch": "tsc --watch"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "colorette": "^2.0.20",
    "commander": "^15.0.0",
    "execa": "^10.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  }
}
